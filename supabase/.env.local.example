# Local Development Environment Variables
# Copy this file to .env.local and add your actual values

# Gemini API Key (Get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Auto-injected by Supabase CLI - no need to set)
# SUPABASE_URL=auto_injected
# SUPABASE_ANON_KEY=auto_injected
# SUPABASE_SERVICE_ROLE_KEY=auto_injected