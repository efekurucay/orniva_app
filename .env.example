# Orniva App Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# CLIENT-SIDE VARIABLES (prefixed with EXPO_PUBLIC_)
# =============================================================================

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =============================================================================
# SERVER-SIDE SECRETS (configured in Supabase Dashboard)
# =============================================================================

# Gemini API Key (Supabase Edge Function Secrets)
# Configure via: supabase secrets set GEMINI_API_KEY=your_key
# ❌ DO NOT put GEMINI_API_KEY in .env file (client-side)

# Service Role Key (Edge Function access only)
# Configure via Supabase Dashboard > Settings > API
# ❌ DO NOT put SERVICE_ROLE_KEY in .env file (client-side)

# =============================================================================
# SETUP INSTRUCTIONS:
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your Supabase URL and anon key
# 3. For server secrets, use Supabase Dashboard > Edge Functions > Secrets
# 4. .env file is automatically ignored by git for security
# =============================================================================
